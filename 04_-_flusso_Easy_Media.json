   },
   "order": 20,
   "mode": 0,
   "inputs": [],
   "outputs": [],
   "properties": {
    "text": "LOCAL COMFYUI — OPTIONAL\n\nUse this section only if you want to generate on your\nown computer instead of RunningHub.\n\nAlready have a working local H3 workflow?\nExport its editable workflow JSON and attach it to\nCodex. Ask:\n\nUse my local workflow as the template. Keep its\ninstalled models and settings. Create this story using\nmy setup.\n\nThen open the resulting JSON in your local ComfyUI,\nselect your reference files, and run it.\n\nDo not have H3 running locally yet?\nSet up ComfyUI, the H3 model files and the required\ncustom nodes first. This workflow does not install them.\nAsk Codex for setup instructions for your computer\nbefore trying to render.\n\nThe workflow's built-in large notes use the Goohai\nannotation node (孤海注释). A local installation needs that\nnode to display these notes.",
    "fontSize": 52,
    "fontColor": "#FFFFFF",
    "backgroundColor": "#20152E",
    "backgroundAlpha": 0.94,
    "borderRadius": 18,
    "padding": 36,
    "lineHeight": 1.25,
    "textAlign": "left",
    "stroke": false,
    "widget_ue_connectable": {}
   },
   "color": "#fff0",
